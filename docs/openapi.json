          "priceCents": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "example": 2500
          },
          "available": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        }
      },
      "ProductUpdate": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Nom non vide après suppression des espaces en début et fin.",
            "example": "Clavier"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Description facultative, espaces en début et fin supprimés.",
            "example": "Clavier USB"
          },
          "priceCents": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "example": 2500
