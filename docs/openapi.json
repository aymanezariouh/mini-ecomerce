      "OrderInput": {
        "type": "object",
        "required": [
          "items"
        ],
        "description": "1 à 10 produits distincts. Seuls productId et quantity sont utilisés. Le client authentifié fournit implicitement son identité. Les champs client totalCents, customer, status, unitPriceCents ou productName sont ignorés : le serveur calcule les prix et totaux depuis MongoDB avant tout enregistrement.",
        "properties": {
