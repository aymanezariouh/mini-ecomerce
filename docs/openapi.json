            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity"
              ],
              "properties": {
                "productId": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{24}$",
                  "example": "507f1f77bcf86cd799439011"
                },
