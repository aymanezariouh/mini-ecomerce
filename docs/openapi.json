          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "seller"
            ]
          }
        },
        "example": {
          "id": "507f1f77bcf86cd799439031",
          "name": "Client Exemple",
          "email": "client@example.test",
          "role": "customer"
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "description": "Compte customer uniquement : tout rôle fourni est ignoré. Email non vide, converti en minuscules et sans espaces en début/fin, unique. Les autres champs sont ignorés.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "required": [
          "message",
          "user"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "example": {
          "message": "User registered successfully",
          "user": {
            "id": "507f1f77bcf86cd799439031",
            "name": "Client Exemple",
            "email": "client@example.test",
            "role": "customer"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "message",
          "token",
          "user"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "JWT signé, valable un jour."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "example": {
          "message": "Login successful",
          "token": "<JWT retourné par la connexion>",
          "user": {
            "id": "507f1f77bcf86cd799439031",
            "name": "Client Exemple",
            "email": "client@example.test",
            "role": "customer"
          }
        }
      },
      "ProductCreate": {
        "type": "object",
        "required": [
          "name",
          "priceCents"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Nom non vide après suppression des espaces en début et fin.",
            "example": "Clavier"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Description facultative, espaces en début et fin supprimés.",
