{
  "openapi": "3.0.3",
  "info": {
    "title": "Mini E-commerce — Sprint 02",
    "version": "1.0.0",
    "description": "Contrat issu des routes et contrôleurs Express. Les montants sont exprimés en centimes entiers. Les erreurs JSON suivent {\"error\":{\"message\":\"Description\"}}. Les routes inconnues renvoient 404 et le JSON mal formé 400. Le catalogue est public ; les permissions sont vérifiées depuis le compte associé au JWT. Cette spécification est la référence des endpoints ; la collection Postman reprend ces opérations avec des scénarios et assertions."
  },
  "servers": [
    {
      "url": "/",
      "description": "Serveur courant"
    }
  ],
  "tags": [
    {
      "name": "Santé"
    },
    {
      "name": "Authentification"
    },
    {
      "name": "Produits"
    },
    {
      "name": "Commandes"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Vérifier que l’API répond",
        "tags": [
          "Santé"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "message": "Erreur interne du serveur"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Créer un compte client",
        "tags": [
          "Authentification"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid registration data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "message": "Invalid registration data"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "message": "Email already registered"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "message": "Erreur interne du serveur"
                  }
                }
              }
            }
          }
        },
        "description": "Inscription publique. Un vendeur doit être créé avec le seed MongoDB. Aucun hash ni mot de passe n’est renvoyé.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              },
              "example": {
                "name": "Client Exemple",
                "email": "client@example.test",
                "password": "<mot de passe de 8 caractères minimum>"
              }
            }
          }
        }
      }
    },
